MONGO_URL=mongodb://localhost:27017
MONGO_DB=statuspage
PRODUCT_NAME=Status
# Next.js reads env from web/.env.local, not this file. Copy this line there.
NEXT_PUBLIC_API_URL=http://localhost:8001
SESSION_SECRET=change-me-to-a-long-random-string
SEED_ADMIN_PASSWORD=
CORS_ORIGINS=http://localhost:3000
# Mail is optional: with SMTP_HOST unset, sending is a logged no-op.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
MAIL_FROM=status@example.com
PUBLIC_BASE_URL=http://localhost:3000
